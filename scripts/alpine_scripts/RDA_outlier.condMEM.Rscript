#Check how much variance is attributable to environment vs. space:
# environmental effect after conditioning out space
RsquareAdj(partial_rda)

print(paste('Colinearity of partial rda variables, vif:'))
vif.cca(partial_rda)

#Environmental Loadings
env_loadings <- scores(partial_rda, display = "bp")
#env_loadings %>% write.table("WAVI.188ind.noHyb.RDAoutlier.loadings.chelsa.cond_topMEM2.txt",row.names=T,quote=F,sep="\t")
# To view the loadings for the first two axes
env_loadings

#pdf("WAVI.188ind.noHyb.RDAoutliers.chelsa.cond_topMEM2.screeplot.pdf")
#screeplot(partial_rda)
