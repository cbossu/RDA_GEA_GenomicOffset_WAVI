#write.table(env_data_mem,"WAVI.env_pland_treecc_ndvi.scaled.188ind.West_SW_SD_NoHyb.inclMEM_sel.allData.csv",row.names=F,quote=F,sep=",")

#Read in forward selection to get environmental variables selected
fit<-readRDS("ForwardSel.WAVI.188ind.West_SW_SD_NoHyb.uncor_env.UncorrectedPop.RDS")

# convert the anova table to a data frame
sel_table <- as.data.frame(fit$anova)

# drop the "<All variables>" summary row, keep only actual selection steps
sel_table <- sel_table[rownames(sel_table) != "<All variables>", ]

# variable names have a "+ " prefix — strip it and trim whitespace
selected_vars <- trimws(gsub("^\\+ ", "", rownames(sel_table)))

print(paste('Selected bioclim variables:'))
selected_vars

## Partial RDA conditioning on MEM
env_terms <- paste(selected_vars, collapse = " + ")  # your env vars from ordiR2step earlier
cond_terms <- paste(sig_mems_top, collapse = " + ")

partial_formula <- as.formula(
  paste("gen.impall ~", env_terms, "+ Condition(", cond_terms, ")")
)

print(paste('Run RDA outlier test, with selected bioclim variables conditioned on top 2 selected MEM.'))

#partial_rda <- rda(partial_formula, data = env_data_mem)
#saveRDS(partial_rda,"WAVI.RDAoutliers.188ind.noHyb.impute.chelsa.cond_topMEM2.RDS")
