## Used plink with a fixed map file to create raw file, and then R to create LFMM file, removed 2nd through 6th column, but kept 1st column for name

# Get current time in the desired format
start_timestamp_txt <- as.POSIXct(format(Sys.time(), "%Y-%m-%d-%H:%M:%S"))
start_timestamp <- as.POSIXct(format(Sys.time(), "%Y-%m-%d-%H:%M:%S"), format = "%Y-%m-%d-%H:%M:%S", tz = 'GMT')

print(paste('Start time:', start_timestamp))

## Now read this in R
## Environment
`%notin%`<-Negate(`%in%`)
#env<-read_delim("WAVI.env_pland_ndvi.200ind.West_SW_SD_Hyb.csv",delim=",") %>% rename(long=Long,lat=Lat)
env<-read_delim("WAVI.env_pland_treecc_ndvi.188ind.West_SW_SD_NoHyb.csv",delim=",") %>% rename(long=Long,lat=Lat)
long_lat<-env %>% dplyr::select(long,lat)
waviSampled <- read_delim("WAVI249.GEA.sample_table.csv",delim=",") %>% rename(long=longitude,lat=latitude) %>% filter(Sample %in% env$Sample)


pred <- env %>% dplyr::select(EvergreenForest:NDVI_mean) # %>% dplyr::select(-HumanImpact_sum)

# Correlation matrix
cor_matrix <- cor(pred, use = "pairwise.complete.obs", method = "pearson")

# Melt for ggplot
cor_melted <- melt(cor_matrix)

#Make sure column names is pred and cor_matrix are the same (note- that they are)
identical(colnames(pred), colnames(cor_matrix))
# findCorrelation returns indices of variables to REMOVE
to_remove <- findCorrelation(cor_matrix, cutoff = 0.7, verbose = TRUE)

# Remove from dataframe
vals_filtered <- pred[, -to_remove]

# Check what was removed and what remains
cat("Removed:", colnames(pred)[to_remove], "\n")
cat("Kept:", colnames(vals_filtered), "\n")

pred<-vals_filtered
pred

pred <- scale(pred, center=TRUE, scale=TRUE) # center=TRUE, scale=TRUE are the defaults for scale()

## Recovering scaling coefficients
scale_env <- attr(pred, 'scaled:scale')
center_env <- attr(pred, 'scaled:center')

## Climatic table as data fram
pred2<-as.data.frame(pred)
row.names(pred2) <- c(waviSampled$Sample)

##Geno
print(paste('Read in genotypes:'))

plink_data <- read.PLINK("WAVI.pass-maf-0.05b.biallelic.rm_mono2.SNP.West_SW_SD_NoHyb.gtgl_impute.convert.raw")
# convert genlight object to a genotype matrix
gen.impall <- as.matrix(plink_data)
dim(gen.impall) #confirm you have the correct # of inds
rm(plink_data)

# extract site scores for first 3 PCs to get PCA
pca<-readRDS("WAVI.188ind.pca.noHyb.RDS")
pc_scores <- scores(pca, display = "sites", choices = 1:2)

#pdf("WAVI.188ind.PCA.noHyb.screeplot.pdf")
#screeplot(pca, bstick = TRUE)  # broken-stick model helps decide how many axes are meaningful
#dev.off()

coords <- env %>% dplyr::select(Sample, long, lat)
# convert to sf object
coords_sf <- st_as_sf(coords, coords = c("long", "lat"), crs = 4326)

# calculate geodesic distance matrix
geo_dist <- geosphere::distm(as(coords_sf, "Spatial"), fun = geosphere::distHaversine)
dist_mat <- as.dist(geo_dist)

# generate moran's eigenvector maps (MEMs)
mem_positive <- adespatial::dbmem(dist_mat, MEM.autocor = "positive")
attr(mem_positive, "values")  # eigenvalues of the retained MEMs

# test MEMs against this reduced genetic summary
#mem_rda_test <- rda(pc_scores ~ ., data = as.data.frame(mem_positive))

#mem_r2step <- ordiR2step(
#  rda(pc_scores ~ 1, data = as.data.frame(mem_positive)),
#  scope = formula(mem_rda_test),
#  direction = "forward"
#)
#saveRDS(mem_r2step,"WAVI.ForwardSel.MEM_positive_on_PCA.RDS")
mem_r2step<-readRDS("WAVI.ForwardSel.MEM_positive_on_PCA.RDS")

#share of variance of significant MEMs
RsquareAdj(mem_r2step)

sig_mems <- attr(mem_r2step$terms, "term.labels")
sig_mems
sig_mems_top<-sig_mems[1:2]


print(paste('Selected MEMs variables:'))
sig_mems_top

# combine MEM scores with your coordinates
mem_df <- as.data.frame(mem_positive)
plot_data <- cbind(coords, mem_df)  # coords has long/lat from earlier

plot_data_long <- plot_data %>%
  pivot_longer(cols = all_of(sig_mems), names_to = "MEM", values_to = "score")

# plot all MEMs as grid (e.g., MEM1) as a bubble map
pdf("WAVI.188ind.noHyb.MEMs_plotted.sig_grid.pdf")
ggplot(plot_data_long, aes(x = long, y = lat, color = score)) +
  geom_point(size = 2) +
  scale_color_gradient2(low = "blue", mid = "white", high = "red", midpoint = 0) +
  coord_fixed() +
  facet_wrap(~ MEM) +
  theme_minimal() +
  labs(color = "MEM score")
dev.off()
print(paste('Plot sig selected MEMs- more than what we will select'))

#add top mems to environment
