print(paste('Run partial RDA, with selected environment variables conditioned on MEMs-first 2'))

## Partial RDA conditioning on MEM
env_terms <- paste(selected_vars, collapse = " + ")  # your env vars from ordiR2step earlier
cond_terms <- paste(sig_mems_top, collapse = " + ")

partial_formula <- as.formula(
  paste("gen.impall ~", env_terms, "+ Condition(", cond_terms, ")"))

partial_rda <- rda(partial_formula, data = env_data_mem)
saveRDS(partial_rda, "WAVI.188ind.NoHyb.exclLD.impute.RDAoutliers_CondMEM2.chelsa.no_land.RDS")
#partial_rda<-readRDS("WAVI.188ind.NoHyb.exclLD.impute.RDAoutliers_CondMEM2.chelsa.no_land.RDS")
print(paste('Ran and saved partial rda conditioned on first 2 MEMs'))

## Variance partitioning
# environmental effect after conditioning out space
RsquareAdj(partial_rda)

vif.cca(partial_rda) 
# variance partitioning: pure environment, pure space, shared, unexplained
# build formulas as strings, then convert to formula objects
env_formula <- as.formula(paste("~", paste(selected_vars, collapse = " + ")))
spatial_formula <- as.formula(paste("~", paste(sig_mems_top, collapse = " + ")))

# run varpart with dynamically built formulas
varpart_result <- varpart(
  gen.impall,           # or gen.impall / your genetic response matrix
  env_formula,
  spatial_formula,
  data = env_data_mem    # data frame containing both env vars and MEM columns
)
saveRDS(varpart_result,"WAVI.188ind.NoHyb.exclLD.VarPart.Env_SelMEM.no_land.RDS")
print(paste('Saved varpart'))
varpart_result
pdf("WAVI.188ind.NoHyb.exclLD.VarPart.Env_SelMEM2.no_land.pdf")
plot(varpart_result)
dev.off()

print(paste('Ran and saved VarPart for selected environmental variables and top MEMs'))

# radapt to identify candidate loci only for now
rdadapt_partial<-rdadapt(partial_rda, 2)

## P-values threshold after Bonferroni correction
thres_env <- 0.01/length(rdadapt_partial$p.values)

## Identifying the loci that are below the p-value threshold
outliersP <- data.frame(Loci = colnames(gen.impall)[which(rdadapt_partial$p.values<thres_env)], p.value = rdadapt_partial$p.values[which(rdadapt_partial$p.values<thres_env)], contig = unlist(lapply(strsplit(colnames(gen.impall)[which(rdadapt_partial$p.values<thres_env)], split = "_"), function(x) x[1]))) 
head(outliersP)

outliersP <- outliersP[order(outliersP$contig, outliersP$p.value), ]

outliersP$snp <- sub("_[ACGT]$", "", outliersP$Loci)
#outliersP$CHROM <- sub("\\.[^.]*$", "", outliersP$snp) # remove the final ".xxxx" segment
#outliersP$POS   <- sub(".*\\.", "", outliersP$snp) # keep only what's after the final "."
outliersP$CHROM <- paste0(sub("RagTag.*$", "", outliersP$snp), "RagTag")
outliersP$POS   <- sub(".*RagTag\\.", "", outliersP$snp)

write.table(outliersP,"WAVI.188ind.noHyb.exclLD.outlier_BonferroniCorr.pvalue.loci.cond_topMEM2.no_land.fix_chrom.txt",row.names=F,quote=F,sep="\t")

# eigenvalues for each constrained RDA axis
eigenvalsP <- partial_rda$CCA$eig

# sum each set of eigenvalues separately, then add totals
total_inertiaP <- sum(partial_rda$CA$eig) + sum(partial_rda$CCA$eig)

# % of total variance for each constrained (RDA) axis
pct_explainedP <- partial_rda$CCA$eig / total_inertiaP * 100

print(paste('Percent variance explained for each RDA axis in a partial RDA'))
pct_explainedP

pct_constrainedP <- partial_rda$CCA$eig / sum(partial_rda$CCA$eig) * 100

print(paste('Proportion of constrained variance for each RDA axis'))
pct_constrainedP

pct1 <- round(pct_constrainedP[1], 2)
pct2 <- round(pct_constrainedP[2], 2)


print(paste('Plot RDA biplot conditioned on top MEM- top 2'))

TAB_varP <- as.data.frame(scores(partial_rda, choices=c(1:2), display="bp"))
TAB_sitesP <- as.data.frame(scores(partial_rda, choices=c(1:2), display="sites")) %>% rownames_to_column(var = "Sample") %>% left_join(waviSampled)

levels(TAB_sitesP$Population) <- c("BlackHills","NorthernMX","Arizona","NM","Nevada","Boulder","Larimer","LaramieMtns","FerrisMountains" ,"RedLodge" , "Lewistown","Bozeman","Anaconda","Tendoy","Helena","Boise","Cascade","NIdaho","Missoula","Augusta_Choteau","Whitefish","CypressHills","NWBC","Mackenzie","Jasper","SwanHills","AlderFlats","Castle","Canmore_Banff","Revelstoke","Kamloops","Pemberton","VancouverIsland","Manning","Silverton","NEWA","NEOR","IkenickCreek","CoOR","Masterson","CoCA","Yosemite")

bg_ind <- c("#CC79A7","#FF6600","#FF3300","#FF6633","#FF6666","#FF9966","#CC3300","#FF3311","#FF6622","#FF7F50","#FF7256","#CD5B45","#C1FFC1","#B4eeb4","#90EE90","#9AFF9A","#33a02c","#33b62c","#33c62c","#37a62c","#00CD00","#008B00","#7CCD7C","#548B54","#2E8B57","#43CD80","#4EEE94","#00FF7F","#00EE76","#00CD66","#008B45","#9ACD32","#698B22","#6B8E23","#556B2F","#6E8B3D","#6E8B2D","#8FBC8F","#698B69","#698B72","#E0EEEE","#838B8B") 


pdf("WAVI.RDAoutlier.188ind.noHyb.impute.exclLD.biplot.chelsa5.partialRDA.condMEM2.no_land.fixed.pdf")
ggplot() +
  geom_hline(yintercept=0, linetype="dashed", color = gray(.80), linewidth=0.2) +
  geom_vline(xintercept=0, linetype="dashed", color = gray(.80), linewidth=0.2) +
  #geom_point(data = TAB_loci, aes(x=RDA1*3, y=RDA2*3), colour = "#EB8055FF", size = 2, alpha = 0.8) + #"#F9A242FF"
  geom_point(data = TAB_sitesP, aes(x=-RDA1, y=RDA2,color= Population), size = 2, alpha = 0.8) +
  geom_segment(data = TAB_varP, aes(xend=-RDA1*18, yend=RDA2*18, x=0, y=0), colour="black", linewidth=0.15, linetype=1, arrow=arrow(length = unit(0.02, "npc"))) +
  geom_text(data = TAB_varP, aes(x= -RDA1*19, y=19*RDA2, label = row.names(TAB_varP)), size = 3, family = "Times") +
  xlab(paste0("RDA 1 (", pct1, "%)")) +
  ylab(paste0("RDA 2 (", pct2, "%)")) +
  facet_wrap(~"Adaptive RDA space- linked loci removed") +
  guides(color=guide_legend(title="Populations")) +
  scale_color_discrete(palette=bg_ind)+
  theme_bw(base_size = 11, base_family = "Times") +
  theme(panel.grid = element_blank(), plot.background = element_blank(), panel.background = element_blank(), strip.text = element_text(size=11))+
  theme(legend.key.size = unit(0.1, "cm"),
    legend.title = element_text(size = 8), # Adjust title font size
    legend.text = element_text(size = 6),   # Adjust label font size
        legend.spacing.x = unit(0.05, "cm"), # Adjust horizontal spacing
    legend.margin = margin(t = 0.01, r = 0.01, b = 0.01, l = 0.01, unit = "cm") # Adjust legend margins
) + theme(aspect.ratio = 1)
dev.off()

