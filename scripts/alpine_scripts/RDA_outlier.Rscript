## Identify candidate loci associated with first 2 RDA axes (only need first 2, 3rd adds very little)
### Get snp scores for the constrained axes 1 thorugh num_axes
num_axes <- 2
loadings <- scores(RDA_outliers, choices = 1:num_axes, display = "species")

# helper function: find outlier SNPs beyond z standard deviations
find_outliers <- function(x, z = 3) {
  lims <- mean(x) + c(-1, 1) * z * sd(x) # threshold: mean ± z*sd
  x[x < lims[1] | x > lims[2]]           # return SNPs outside limits
}

# identify outlier SNPs for each axis
outlier_list <- lapply(1:num_axes, function(ax) {
  vals <- loadings[, ax]
  snps <- find_outliers(vals, z = 3)
  data.frame(
    axis     = ax,
    snp      = names(snps),
    loading  = unname(snps),
    stringsAsFactors = FALSE
  )
})

# combine into one dataframe
outliers_df <- do.call(rbind, outlier_list)

#  total number of candidate SNPs
n_candidates <- nrow(outliers_df)
cat("Number of candidate SNPs:", n_candidates, "\n")

predictors <- pred2[selected_vars]
cor_mat <- matrix(nrow = n_candidates, ncol = ncol(predictors))
colnames(cor_mat) <- colnames(predictors)

for (i in 1:n_candidates) {
  snp_name <- outliers_df$snp[i]
  snp_gen  <- gen.impall[, snp_name]
  cor_mat[i, ] <- apply(predictors, 2, function(x) cor(x, snp_gen))
}

cand <- cbind(outliers_df, cor_mat)

# remove SNPs detected on multiple axes
cand <- cand[!duplicated(cand$snp), ]

# identify which predictor each SNP is most strongly correlated with
predictor_cols <- colnames(predictors)

cand$predictor <- apply(cand[, predictor_cols], 1, function(row) {
  predictor_cols[which.max(abs(row))]
})

cand$correlation <- apply(cand[, predictor_cols], 1, function(row) {
  max(abs(row))
})

# print number of SNPs per predictor
table(cand$predictor)

cand$snp2 <- sub("_[ACGT]$", "", cand$snp)
cand$CHROM <- paste0(sub("RagTag.*$", "", cand$snp2), "RagTag")
cand$POS   <- sub(".*RagTag\\.", "", cand$snp2)
saveRDS(cand, "WAVI.188ind.noHyb.RDAoutlier.candidate_snps_with_correlation.chrom_fix.RDS")

candidate_snps <- cand$snp
saveRDS(candidate_snps,"candidate_snps_noci.rds")

cand_pos <- t(sapply(candidate_snps, function(x) {
  # split chrom vs position/allele
 if (!grepl("RagTag", x)) {
    cat("Problem SNP (no 'RagTag'):", x, "\n")
    return(c(CHROM = NA, POS = NA))
  }
  
  chrom <- paste0(sub("RagTag.*$", "", x), "RagTag")
  pos_allele <- sub(".*RagTag\\.", "", x)
#  chrom <- parts[c(1,2)]  # scaffold name
#  pos_allele <- parts[3]
  
  # extract numeric position before underscore
  pos <- suppressWarnings(as.integer(str_split(pos_allele, "_")[[1]][1]))
  
  if (is.na(pos)) {
    cat("Could not parse position for SNP:", x, "\n")
  }
  
  c(CHROM = chrom, POS = pos)
}))

# convert to data frame
cand_pos <- as.data.frame(cand_pos, stringsAsFactors = FALSE)
cand_pos$POS <- as.integer(cand_pos$POS)


cat("Number of NA positions:", sum(is.na(cand_pos$POS)), "\n")
print(head(cand_pos, 10))

# write out
write_tsv(cand_pos, "candidate_adaptive_snps_subset.tsv", col_names = FALSE)

print(paste('Identify candidate loci using p-value and Bonferonni correction'))

source("rdadapt.R")
## Running the function with K = 2
rdadapt_env<-rdadapt(RDA_outliers, 2)
head(rdadapt_env)
tot<-cbind(colnames(gen.impall),rdadapt_env) %>% mutate(snp=sub("_[ACGT]$", "", `colnames(gen.impall)`),CHROM=paste0(sub("RagTag.*$", "", snp), "RagTag"),POS=sub(".*RagTag\\.", "", snp))
head(tot)
tail(tot)
tot %>% write.table("output/WAVI.RDAoutlier.188ind.noHyb.rdadapt_env.p_q_value.txt",row.names=F,quote=F,sep="\t")
## P-values threshold after Bonferroni correction
thres_env <- 0.05/length(rdadapt_env$p.values)

## Identifying the loci that are below the p-value threshold
outliers <- data.frame(Loci = colnames(gen.impall)[which(rdadapt_env$p.values<thres_env)], p.value = rdadapt_env$p.values[which(rdadapt_env$p.values<thres_env)], contig = unlist(lapply(strsplit(colnames(gen.impall)[which(rdadapt_env$p.values<thres_env)], split = "_"), function(x) x[1]))) 
head(outliers)
dim(outliers)
outliers <- outliers[order(outliers$contig, outliers$p.value), ]

outliers$snp <- sub("_[ACGT]$", "", outliers$Loci)
#outliers$CHROM <- sub("\\.[^.]*$", "", outliers$snp) # remove the final ".xxxx" segment
#outliers$POS   <- sub(".*\\.", "", outliers$snp) # keep only what's after the final "."
outliers$CHROM <- paste0(sub("RagTag.*$", "", outliers$Loci), "RagTag")
outliers$POS   <- sub(".*RagTag\\.", "", outliers$Loci)
write.table(outliers,"WAVI.188ind.noHyb.outlier_BonferroniCorr.rdadapt_05pvalue.loci.fix_chrom.txt",row.names=F,quote=F,sep="\t")

## Formatting table for ggplot
locus_scores <- scores(RDA_outliers, choices=c(1:2), display="species", scaling="none") #these are loci (but we don't want 7 million)
TAB_loci <- data.frame(names = row.names(locus_scores), locus_scores)
TAB_loci$type <- "Neutral"
TAB_loci$type[TAB_loci$names %in% outliers$Loci] <- "All outliers"
TAB_loci$type <- factor(TAB_loci$type, levels = c("Neutral", "All outliers"))
TAB_loci %>% distinct(type)
## Subset Neutral loci to 100K, keep all outliers
set.seed(42)  # for reproducibility

neutral_rows  <- TAB_loci[TAB_loci$type == "Neutral", ]
outlier_rows  <- TAB_loci[TAB_loci$type == "All outliers", ]

if (nrow(neutral_rows) > 100000) {
  neutral_rows <- neutral_rows[sample(nrow(neutral_rows), 400000), ]
}

TAB_loci2 <- rbind(neutral_rows, outlier_rows)
TAB_loci2 <- TAB_loci2[order(TAB_loci2$type), ]

TAB_var <- as.data.frame(scores(RDA_outliers, choices=c(1,2), display="bp"))

## Biplot of RDA loci and variables scores
pdf("WAVI.188ind.noHyb.RDAoutlier_loci_plot.rdadapt_05pvalue.subet.pdf")
ggplot() +
  geom_hline(yintercept=0, linetype="dashed", color = gray(.80), size=0.6) +
  geom_vline(xintercept=0, linetype="dashed", color = gray(.80), size=0.6) +
  geom_point(data = TAB_loci2, aes(x=RDA1*61, y=RDA2*61, colour = type), size = 1.4) +
  scale_color_manual(values = c("gray90", "#F9A242FF", "#6B4596FF")) +
  geom_segment(data = TAB_var, aes(xend=RDA1, yend=RDA2, x=0, y=0), colour="black", size=0.15, linetype=1, arrow=arrow(length = unit(0.02, "npc"))) +
  geom_text(data = TAB_var, aes(x=1.1*RDA1, y=1.1*RDA2, label = row.names(TAB_var)), size = 2.5, family = "Times") +
  xlab("RDA 1") + ylab("RDA 2") +
  facet_wrap(~"RDA space") +
  guides(color=guide_legend(title="Locus type")) +
  theme_bw(base_size = 11, base_family = "Times") +
  theme(panel.background = element_blank(), legend.background = element_blank(), panel.grid = element_blank(), plot.background = element_blank(), legend.text=element_text(size=rel(.8)), strip.text = element_text(size=11))
dev.off()



## Manhattan plot
Outliers <- rep("Neutral", length(colnames(gen.impall)))
Outliers[colnames(gen.impall)%in%outliers$Loci] <- "All outliers"
Outliers <- factor(Outliers, levels = c("Neutral", "All outliers"))
TAB_manhatan <- data.frame(pos = 1:length(colnames(gen.impall)),
                           pvalues = rdadapt_env$p.values,
                           Outliers = Outliers)

## Subset Neutral loci to 1 million for manhattan plot, keep all outliers
set.seed(42)  # for reproducibility

neutral_rows  <- TAB_manhatan[TAB_manhatan$Outliers == "Neutral", ]
outlier_rows  <- TAB_manhatan[TAB_manhatan$Outliers == "All outliers", ]

if (nrow(neutral_rows) > 1000000) {
  neutral_rows <- neutral_rows[sample(nrow(neutral_rows), 1000000), ]
  }

TAB_manhatan2 <- rbind(neutral_rows, outlier_rows)
TAB_manhatan2 <- TAB_manhatan2[order(TAB_manhatan2$Outliers), ]

manhattan_plot<-ggplot(data = TAB_manhatan2) +
  geom_point(aes(x=pos, y=-log10(pvalues), col = Outliers), size=1.4) +
  scale_color_manual(values = c("gray90", "#F9A242FF", "#6B4596FF")) +
  xlab("Loci") + ylab("-log10(p.values)") +
  geom_hline(yintercept=-log10(thres_env), linetype="dashed", color = gray(.80), size=0.6) +
  facet_wrap(~"Manhattan plot", nrow = 3) +
  guides(color=guide_legend(title="Locus type")) +
  theme_bw(base_size = 11, base_family = "Times") +
  theme(legend.position="right", legend.background = element_blank(), panel.grid = element_blank(), legend.box.background = element_blank(), plot.background = element_blank(), panel.background = element_blank(), legend.text=element_text(size=rel(.8)), strip.text = element_text(size=11))

ggsave(
  filename = "WAVI.188ind.noHyb.Rdadapt_outlier_manhattan_plot.05pvalue.sub1M_netural.png",
  plot = manhattan_plot,      # or your specific plot object, e.g., manhattan_plot
  width = 12,              # inches — adjust based on how wide your Manhattan plot needs to be
  height = 6,               # inches
  dpi = 600,                # 300 = standard "high-res"; 600 = print-quality/journal-grade
  units = "in",
  bg = "white"               # ensures no transparent background issues
)
