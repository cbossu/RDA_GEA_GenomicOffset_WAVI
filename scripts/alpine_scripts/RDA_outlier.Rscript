print(paste('Colinearity of selected env variables'))
vif.cca(RDA_outliers)

# eigenvalues for each constrained RDA axis
eigenvals <- RDA_outliers$CCA$eig

# sum each set of eigenvalues separately, then add totals
total_inertia <- sum(RDA_outliers$CA$eig) + sum(RDA_outliers$CCA$eig)

# % of total variance for each constrained (RDA) axis
pct_explained <- RDA_outliers$CCA$eig / total_inertia * 100

print(paste('Percent variance explained for each RDA axis'))
pct_explained

# proportion of constrained variance per RDA axis
pct_constrained <- RDA_outliers$CCA$eig / sum(RDA_outliers$CCA$eig) * 100

print(paste('Proportion of constrained variance explained for each RDA axis in a partial RDA'))
pct_constrained
pct1 <- round(pct_constrained[1], 2)
pct2 <- round(pct_constrained[2], 2)

TAB_var <- as.data.frame(scores(RDA_outliers, choices=c(1:2), display="bp"))
TAB_sites <- as.data.frame(scores(RDA_outliers, choices=c(1:2), display="sites")) %>% rownames_to_column(var = "Sample") %>% left_join(waviSampled)

levels(TAB_sites$Population) <- c("BlackHills","NorthernMX","Arizona","NM","Nevada","Boulder","Larimer","LaramieMtns","FerrisMountains" ,"RedLodge" , "Lewistown","Bozeman","Anaconda","Tendoy","Helena","Boise","Cascade","NIdaho","Missoula","Augusta_Choteau","Whitefish","CypressHills","NWBC","Mackenzie","Jasper","SwanHills","AlderFlats","Castle","Canmore_Banff","Revelstoke","Kamloops","Pemberton","VancouverIsland","Manning","Silverton","NEWA","NEOR","IkenickCreek","CoOR","Masterson","CoCA","Yosemite")

bg_ind <- c("#CC79A7","#FF6600","#FF3300","#FF6633","#FF6666","#FF9966","#CC3300","#FF3311","#FF6622","#FF7F50","#FF7256","#CD5B45","#C1FFC1","#B4eeb4","#90EE90","#9AFF9A","#33a02c","#33b62c","#33c62c","#37a62c","#00CD00","#008B00","#7CCD7C","#548B54","#2E8B57","#43CD80","#4EEE94","#00FF7F","#00EE76","#00CD66","#008B45","#9ACD32","#698B22","#6B8E23","#556B2F","#6E8B3D","#6E8B2D","#8FBC8F","#698B69","#698B72","#E0EEEE","#838B8B") 

