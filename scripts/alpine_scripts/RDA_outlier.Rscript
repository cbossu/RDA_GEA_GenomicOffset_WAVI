  geom_text(data = TAB_var, aes(x= -RDA1*19, y=19*RDA2, label = row.names(TAB_var)), size = 3, family = "Times") +
  xlab(paste0("RDA 1 (", pct1, "%)")) +
  ylab(paste0("RDA 2 (", pct2, "%)")) +
