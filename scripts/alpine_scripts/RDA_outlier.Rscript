RsquareAdj(RDA_outliers)

print(paste('Summary of RDA model, constrained only'))

summary(eigenvals(RDA_outliers, model = "constrained"))

#Environmental Loadings
env_loadings <- scores(RDA_outliers, display = "bp")
#env_loadings %>% write.table("WAVI188.noHyb.RDA_outlier.loadings.chelsa.txt",row.names=T,quote=F,sep="\t")
